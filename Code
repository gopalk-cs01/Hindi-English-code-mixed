        "def detect_hate(target):\n",
        "    return \"Hate\" if target in [\"O\", \"I\", \"R\"] else \"Not Hate\"\n",
        "\n",
        "def detect_category(tweet):\n",
        "    tweet = str(tweet).lower()\n",
        "\n",
        "    religion_keywords = [\n",
        "        \"muslim\", \"hindu\", \"islam\", \"allah\", \"ram\", \"shree ram\", \"mandir\",\n",
        "        \"masjid\", \"mulle\", \"tablighi\", \"quran\", \"puja\", \"biryani\", \"temple\"\n",
        "    ]\n",
        "    caste_keywords = [\n",
        "        \"dalit\", \"jati\", \"brahmin\", \"chamar\", \"shudra\", \"varna\", \"caste\", \"jaat\", \"scheduled caste\"\n",
        "    ]\n",
        "    region_keywords = [\n",
        "        \"pakistan\", \"india\", \"delhi\", \"kashmir\", \"bangladesh\", \"bhoomi poojan\",\n",
        "        \"america\", \"up\", \"bihar\", \"gujarat\", \"china\", \"state\", \"region\", \"country\"\n",
        "    ]\n",
        "    gender_keywords = [\n",
        "        \"woman\", \"girl\", \"boy\", \"female\", \"male\", \"sexist\", \"patriarchy\", \"gender\",\n",
        "        \"rape\", \"feminist\", \"feminazi\", \"eve-teasing\", \"dowry\", \"molestation\"\n",
        "    ]\n",
        "    cyberbully_keywords = [\n",
        "        \"cyberbully\", \"troll\", \"abuse\", \"harass\", \"online threat\", \"dm\", \"dox\", \"target\",\n",
        "        \"blackmail\", \"spam\", \"stalk\", \"creep\", \"leak\", \"anonymous\", \"hack\"\n",
        "    ]\n",
        "\n",
        "    if any(word in tweet for word in religion_keywords):\n",
        "        return \"Religion/Radicalization\"\n",
        "    elif any(word in tweet for word in caste_keywords):\n",
        "        return \"Caste\"\n",
        "    elif any(word in tweet for word in region_keywords):\n",
        "        return \"Demography/Region\"\n",
        "    elif any(word in tweet for word in gender_keywords):\n",
        "        return \"Gender/Sexism\"\n",
        "    elif any(word in tweet for word in cyberbully_keywords):\n",
        "        return \"Cyberbullying\"\n",
        "    else:\n",
        "        return \"N/A\"\n",
        "\n",
        "# Step 3: Apply the functions to each row\n",
        "# df[\"Fake/Real\"] = df[\"Target\"].apply(detect_fake)\n",
        "c=0\n",
        "if c!=0:\n",
        "  df[\"Hate/Not Hate\"] = df[\"Target\"].apply(detect_hate)\n",
        "  df[\"Category\"] = df[\"Tweet\"].apply(detect_category)\n",
        "\n",
        "# Step 4: Save to a new CSV\n",
        "df = pd.read_csv(r\"tweet_data_updated.csv\" )\n",
        "df"
