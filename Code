        "from transformers import AutoTokenizer, AutoModelForSequenceClassification, pipeline\n",
        "import pandas as pd\n",
        "from tqdm import tqdm\n",
        "import torch\n",
        "import time\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"🚀 Starting Fake/Real Tweet Classification\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "# ---------------------- 1. Load Model ----------------------\n",
        "model_name = \"bert-base-multilingual-cased\"\n",
        "print(f\"\\n📥 Loading model: {model_name} ...\")\n",
        "\n",
        "tokenizer = AutoTokenizer.from_pretrained(model_name)\n",
        "model = AutoModelForSequenceClassification.from_pretrained(model_name, num_labels=2)\n",
        "\n",
        "device = 0 if torch.cuda.is_available() else -1\n",
        "device_name = \"GPU\" if device == 0 else \"CPU\"\n",
        "print(f\"✅ Model loaded successfully on {device_name}\")\n",
        "\n",
        "classifier = pipeline(\n",
        "    \"text-classification\",\n",
        "    model=model,\n",
        "    tokenizer=tokenizer,\n",
        "    device=device,\n",
        "    truncation=True,\n",
        "    max_length=128\n",
        ")\n",
        "\n",
        "# ---------------------- 2. Load Data ----------------------\n",
        "print(\"\\n📂 Loading CSV file...\")\n",
        "df = pd.read_csv(r\"tweet_data_updated.csv\")\n",
        "\n",
        "# Clean empty tweets\n",
        "df = df[df['Tweet'].apply(lambda x: isinstance(x, str) and x.strip() != \"\")].copy()\n",
        "tweets = df['Tweet'].tolist()\n",
        "\n",
        "print(f\"✅ Total tweets to process: {len(tweets)}\")\n",
        "\n",
        "# ---------------------- 3. Classification with Progress ----------------------\n",
        "batch_size = 32\n",
        "results = []\n",
        "\n",
        "print(f\"\\n🔍 Classifying tweets in batches of {batch_size}...\\n\")\n",
        "\n",
        "start_time = time.time()\n",
        "\n",
        "for i in tqdm(range(0, len(tweets), batch_size), desc=\"Processing\", unit=\"batch\"):\n",
        "    batch = tweets[i:i + batch_size]\n",
        "    batch_results = classifier(batch)\n",
        "    results.extend(batch_results)\n",
        "\n",
        "elapsed = time.time() - start_time\n",
        "print(f\"\\n✅ Classification completed in {elapsed:.1f} seconds\")\n",
        "print(f\"⚡ Speed: {len(tweets)/elapsed:.1f} tweets/second\")\n",
        "\n",
        "# ---------------------- 4. Map Labels ----------------------\n",
        "print(\"\\n🏷️  Mapping labels...\")\n",
        "\n",
        "def label_to_binary(result):\n",
        "    # LABEL_0 → Fake (1), LABEL_1 → Real (0)  ← adjust if needed\n",
        "    return 1 if result['label'].lower() in ['label_0', 'label_0'] else 0\n",
        "\n",
        "labels = [label_to_binary(r) for r in results]\n",
        "df['Fake/Real'] = labels\n",
        "\n",
        "# ---------------------- 5. Save Result ----------------------\n",
        "output_file = \"tweets_labeled_hinglish.csv\"\n",
        "df.to_csv(output_file, index=False)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 60)\n",
        "print(f\"🎉 DONE! File saved as → {output_file}\")\n",
        "print(f\"📊 Total tweets labeled: {len(df)}\")\n",
        "print(f\"🔴 Fake tweets: {(df['Fake/Real'] == 1).sum()}\")\n",
        "print(f\"🟢 Real tweets: {(df['Fake/Real'] == 0).sum()}\")\n",
        "print(\"=\" * 60)"
      ]
    },
