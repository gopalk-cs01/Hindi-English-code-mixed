      "source": [
        "import nltk\n",
        "import re\n",
        "import pandas as pd\n",
        "from nltk.corpus import stopwords, words\n",
        "from nltk.tokenize import word_tokenize\n",
        "from nltk.stem import PorterStemmer\n",
        "\n",
        "# Download NLTK resources (only first time)\n",
        "nltk.download('punkt')\n",
        "nltk.download('stopwords')\n",
        "nltk.download('words')\n",
        "\n",
        "# Global definitions\n",
        "stop_words = set(stopwords.words('english'))\n",
        "english_vocab = set(word.lower() for word in words.words())\n",
        "stemmer = PorterStemmer()\n",
        "\n",
        "def normalize_repeated_chars(word):\n",
        "    return re.sub(r'(.)\\1{2,}', r'\\1\\1', word)\n",
        "\n",
        "def preprocess_text(text):\n",
        "    if not isinstance(text, str):\n",
        "        return []\n",
        "\n",
        "    text = text.lower()\n",
        "\n",
        "    # Keep only letters and spaces\n",
        "    text = re.sub(r\"[^a-z\\s]\", \" \", text)\n",
        "\n",
        "    # Tokenize\n",
        "    tokens = word_tokenize(text)\n",
        "\n",
        "    cleaned_tokens = []\n",
        "\n",
        "    for token in tokens:\n",
        "\n",
        "        # Skip extremely long tokens\n",
        "        if len(token) > 25:\n",
        "            continue\n",
        "\n",
        "        token = normalize_repeated_chars(token)\n",
        "\n",
        "        stemmed = stemmer.stem(token)\n",
        "\n",
        "        if (\n",
        "            stemmed in english_vocab\n",
        "            and stemmed not in stop_words\n",
        "            and len(stemmed) > 1\n",
        "        ):\n",
        "            cleaned_tokens.append(stemmed)\n",
        "\n",
        "    return cleaned_tokens\n",
        "\n",
        "\n",
        "# Wrapper\n",
        "def pp_pipeline(text):\n",
        "    return preprocess_text(text)\n",
        "\n",
        "\n",
        "# Load dataset\n",
        "df = pd.read_csv(\n",
        "    r\"converted_output.csv\"\n",
        ")\n",
        "\n",
        "# Replace missing values\n",
        "df[\"english_translation\"] = df[\"english_translation\"].fillna(\"\")\n",
        "\n",
        "# Apply preprocessing\n",
        "features_list = df[\"english_translation\"].apply(pp_pipeline)\n",
        "\n",
        "# Convert list of tokens into columns\n",
        "features_df = pd.DataFrame(features_list.tolist())\n",
        "\n",
        "# Merge with original dataframe\n",
        "df_features = pd.concat([df, features_df], axis=1)\n",
        "\n",
        "# Save output\n",
        "output_path = r\"pp_data.csv\"\n",
        "df_features.to_csv(output_path, index=False)\n",
        "\n",
        "print(\"Preprocessing completed successfully!\")\n",
        "print(f\"Processed {len(df_features)} rows.\")\n",
        "print(f\"Saved file to:\\n{output_path}\")"
      ]
