        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "from torch.utils.data import DataLoader, TensorDataset\n",
        "from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, hamming_loss, mean_absolute_error, mean_squared_error\n",
        "from lime.lime_tabular import LimeTabularExplainer\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import os\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "df = pd.read_csv(r\"pp_data.csv\")\n",
        "# print(df.columns)\n",
        "# df['y_fake'] = df['Fake/Real'].map({'Real': 0, 'Fake': 1}).fillna(0).astype(int)\n",
        "df['y_fake'] = df['Fake/Real'].fillna(0).astype(int)\n",
        "df['y_hate'] = df['Hate/Not Hate'].map({'Not Hate': 0, 'Hate': 1}).fillna(0).astype(int)\n",
        "df['y_severity'] = pd.to_numeric(df['Severity'], errors='coerce').fillna(0)\n",
        "\n",
        "categories = df['Category'].fillna('None').unique()\n",
        "cat2idx = {cat: i for i, cat in enumerate(categories)}\n",
        "df['y_multi'] = df['Category'].fillna('None').map(cat2idx)\n",
        "\n",
        "input_size = 20\n",
        "X = torch.randn(len(df), input_size).float()\n",
        "\n",
        "# Targets\n",
        "y_fake = torch.tensor(df['y_fake'].values).float().unsqueeze(1)\n",
        "y_hate = torch.tensor(df['y_hate'].values).float().unsqueeze(1)\n",
        "\n",
        "# You forgot y_synergy, so create dummy data here, replace with your actual data\n",
        "y_synergy = torch.randint(0, 2, (len(df), 1)).float()  # binary dummy labels\n",
        "\n",
        "y_multi = torch.nn.functional.one_hot(torch.tensor(df['y_multi'].values), num_classes=len(categories)).float()\n",
        "y_severity = torch.tensor(df['y_severity'].values).float().unsqueeze(1)\n",
        "\n",
        "# print(f\"Shapes: y_fake={y_fake.shape}, y_hate={y_hate.shape}, y_synergy={y_synergy.shape}, y_multi={y_multi.shape}, y_severity={y_severity.shape}\")\n",
        "\n",
        "targets = (y_fake, y_hate, y_synergy, y_multi, y_severity)\n",
        "\n",
        "dataset = TensorDataset(X, *targets)\n",
        "train_loader = DataLoader(dataset, batch_size=32, shuffle=True)\n",
        "\n",
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "\n",
        "class ToxicSynergyModel(nn.Module):\n",
        "    def __init__(self, input_size, hidden_size, num_heads=4, num_layers=2):\n",
        "        super().__init__()\n",
        "        self.input_proj = nn.Linear(input_size, hidden_size)\n",
        "        encoder_layer = nn.TransformerEncoderLayer(d_model=hidden_size, nhead=num_heads, batch_first=True)\n",
        "        self.transformer_encoder = nn.TransformerEncoder(encoder_layer, num_layers=num_layers)\n",
        "\n",
        "        self.fake_news_head = nn.Linear(hidden_size, 1)\n",
        "        self.hate_speech_head = nn.Linear(hidden_size, 1)\n",
        "        self.toxic_synergy_head = nn.Linear(hidden_size, 1)\n",
        "        self.multi_label_head = nn.Linear(hidden_size, len(categories))  # number of classes\n",
        "        self.severity_head = nn.Linear(hidden_size, 1)\n",
        "\n",
        "    def forward(self, x):\n",
        "        x = x.unsqueeze(1)  # shape: [B, 1, input_size]\n",
        "        x = self.input_proj(x)  # [B, 1, hidden_size]\n",
        "        x = self.transformer_encoder(x)  # [B, 1, hidden_size]\n",
        "        x = x.squeeze(1)  # [B, hidden_size]\n",
        "\n",
        "        fake_news = self.fake_news_head(x)\n",
        "        hate_speech = self.hate_speech_head(x)\n",
        "        toxic_synergy = self.toxic_synergy_head(x)\n",
        "        multi_label = self.multi_label_head(x)\n",
        "        severity = self.severity_head(x)\n",
        "\n",
        "        # For BCEWithLogitsLoss, do NOT apply sigmoid here. Return raw logits.\n",
        "        return fake_news, hate_speech, toxic_synergy, multi_label, severity\n",
        "\n",
        "class CombinedLoss(nn.Module):\n",
        "    def __init__(self, alpha=0.25, gamma=2):\n",
        "        super().__init__()\n",
        "        self.bce_logits = nn.BCEWithLogitsLoss()\n",
        "        self.alpha = alpha\n",
        "        self.gamma = gamma\n",
        "\n",
        "    def focal_loss(self, outputs, targets):\n",
        "        BCE_loss = F.binary_cross_entropy_with_logits(outputs, targets, reduction='none')\n",
        "        pt = torch.exp(-BCE_loss)\n",
        "        focal_loss = self.alpha * (1 - pt) ** self.gamma * BCE_loss\n",
        "        return focal_loss.mean()\n",
        "\n",
        "    def forward(self, outputs, targets):\n",
        "        fake_news, hate_speech, toxic_synergy, multi_label, severity = outputs\n",
        "        y_fake, y_hate, y_synergy, y_multi, y_severity = targets\n",
        "\n",
        "        loss_fake = self.focal_loss(fake_news, y_fake)\n",
        "        loss_hate = self.focal_loss(hate_speech, y_hate)\n",
        "        loss_synergy = self.focal_loss(toxic_synergy, y_synergy)\n",
        "        loss_multi = self.bce_logits(multi_label, y_multi)\n",
        "        loss_regression = F.mse_loss(severity, y_severity)\n",
        "        return loss_fake + loss_hate + loss_synergy + loss_multi + loss_regression\n",
        "\n",
        "def train_model(model, train_loader, optimizer, criterion, epochs=10, device='cuda'):\n",
        "    model.train()\n",
        "    loss_per_epoch = []\n",
        "    acc_per_epoch = []\n",
        "\n",
        "    for epoch in range(epochs):\n",
        "        total_loss = 0\n",
        "\n",
        "        correct = 0\n",
        "        total = 0\n",
        "\n",
        "        for data, *targets in train_loader:\n",
        "            # data = data.to(device)\n",
        "            # targets = tuple(t.to(device) for t in targets)\n",
        "            targets = tuple(t for t in targets)\n",
        "\n",
        "            optimizer.zero_grad()\n",
        "\n",
        "            outputs = model(data)\n",
        "\n",
        "            loss = criterion(outputs, targets)\n",
        "\n",
        "            loss.backward()\n",
        "            optimizer.step()\n",
        "\n",
        "            total_loss += loss.item()\n",
        "\n",
        "            # --------- Training Accuracy (Fake News Task) ---------\n",
        "            preds = (torch.sigmoid(outputs[0]) >= 0.5).float()\n",
        "            correct += (preds == targets[0]).sum().item()\n",
        "            total += targets[0].numel()\n",
        "            # ------------------------------------------------------\n",
        "\n",
        "        avg_loss = total_loss / len(train_loader)\n",
        "        train_acc = correct / total\n",
        "\n",
        "        loss_per_epoch.append(avg_loss)\n",
        "        acc_per_epoch.append(train_acc)\n",
        "\n",
        "        print(\n",
        "            f\"Epoch {epoch+1}/{epochs}, \"\n",
        "            f\"Loss: {avg_loss:.4f}, \"\n",
        "            f\"Accuracy: {train_acc*100:.2f}%\"\n",
        "        )\n",
        "\n",
        "    # -------- Loss Plot --------\n",
        "    plt.figure(figsize=(6,4))\n",
        "    plt.plot(range(1, epochs + 1), loss_per_epoch,\n",
        "             marker='o', label='Loss')\n",
        "    plt.title(\"Training Loss\")\n",
        "    plt.xlabel(\"Epoch\")\n",
        "    plt.ylabel(\"Loss\")\n",
        "    plt.grid(True)\n",
        "    plt.legend()\n",
        "    plt.tight_layout()\n",
        "    plt.savefig(\"training_loss.png\")\n",
        "    plt.show()\n",
        "\n",
        "    # -------- Accuracy Plot --------\n",
        "    plt.figure(figsize=(6,4))\n",
        "    plt.plot(range(1, epochs + 1), acc_per_epoch,\n",
        "             marker='o', color='green', label='Accuracy')\n",
        "    plt.title(\"Training Accuracy\")\n",
        "    plt.xlabel(\"Epoch\")\n",
        "    plt.ylabel(\"Accuracy\")\n",
        "    plt.grid(True)\n",
        "    plt.legend()\n",
        "    plt.tight_layout()\n",
        "    plt.savefig(\"training_accuracy.png\")\n",
        "    plt.show()\n",
        "def evaluate(model, test_loader):\n",
        "    model.eval()\n",
        "    all_preds = [[] for _ in range(5)]\n",
        "    all_trues = [[] for _ in range(5)]\n",
        "    with torch.no_grad():\n",
        "        for data, *targets in test_loader:\n",
        "            data = data.to(device)\n",
        "            targets = tuple(t.to(device) for t in targets)\n",
        "\n",
        "            outputs = model(data)\n",
        "            # Apply sigmoid to logits for binary/multi-label outputs\n",
        "            fake_news_pred = torch.sigmoid(outputs[0])\n",
        "            hate_speech_pred = torch.sigmoid(outputs[1])\n",
        "            synergy_pred = torch.sigmoid(outputs[2])\n",
        "            multi_label_pred = torch.sigmoid(outputs[3])\n",
        "            severity_pred = outputs[4]\n",
        "\n",
        "            # Collect preds and trues\n",
        "            all_preds[0].extend(fake_news_pred.cpu().numpy())\n",
        "            all_preds[1].extend(hate_speech_pred.cpu().numpy())\n",
        "            all_preds[2].extend(synergy_pred.cpu().numpy())\n",
        "            all_preds[3].extend(multi_label_pred.cpu().numpy())\n",
        "            all_preds[4].extend(severity_pred.cpu().numpy())\n",
        "\n",
        "            for i in range(5):\n",
        "                all_trues[i].extend(targets[i].cpu().numpy())\n",
        "\n",
        "    y_fake_pred = np.round(np.array(all_preds[0]))\n",
        "    y_fake_true = np.array(all_trues[0])\n",
        "\n",
        "    y_hate_pred = np.round(np.array(all_preds[1]))\n",
        "    y_hate_true = np.array(all_trues[1])\n",
        "\n",
        "    y_synergy_pred = np.round(np.array(all_preds[2]))\n",
        "    y_synergy_true = np.array(all_trues[2])\n",
        "\n",
        "    y_multi_pred = np.round(np.array(all_preds[3]))\n",
        "    y_multi_true = np.array(all_trues[3])\n",
        "\n",
        "    y_severity_pred = np.array(all_preds[4])\n",
        "    y_severity_true = np.array(all_trues[4])\n",
        "\n",
        "    print(\"--- Binary Classification Metrics ---\")\n",
        "    print(\"Fake News Accuracy:\", accuracy_score(y_fake_true, y_fake_pred))\n",
        "    print(\"Hate Speech F1:\", f1_score(y_hate_true, y_hate_pred))\n",
        "    print(\"Synergy Recall:\", recall_score(y_synergy_true, y_synergy_pred))\n",
        "\n",
        "    print(\"--- Multi-Label Classification Metrics ---\")\n",
        "    print(\"Hamming Loss:\", hamming_loss(y_multi_true, y_multi_pred))\n",
        "    # print(\"Subset Accuracy:\", accuracy_score(y_multi_true, y_multi_pred))\n",
        "\n",
        "    print(\"--- Regression Metrics (Severity) ---\")\n",
        "    print(\"MAE:\", mean_absolute_error(y_severity_true, y_severity_pred))\n",
        "    print(\"RMSE:\", np.sqrt(mean_squared_error(y_severity_true, y_severity_pred)))\n",
        "\n",
        "def explain_prediction(model, sample, training_data, save_path=\"lime_explanation.html\"):\n",
        "    model.eval()\n",
        "\n",
        "    def predict_fn(x):\n",
        "        x_tensor = torch.tensor(x, dtype=torch.float32).to(device)\n",
        "        with torch.no_grad():\n",
        "            outputs = model(x_tensor)\n",
        "            probs = torch.sigmoid(outputs[0]).cpu().numpy()  # fake_news output\n",
        "            probs = np.clip(probs, 1e-6, 1 - 1e-6)\n",
        "            return np.hstack([1 - probs, probs])  # For LIME: [P(non-fake), P(fake)]\n",
        "\n",
        "    explainer = LimeTabularExplainer(\n",
        "        training_data=np.array(training_data),\n",
        "        mode=\"classification\",\n",
        "        feature_names=[f\"f{i}\" for i in range(sample.shape[1])],\n",
        "        class_names=[\"Non-Fake\", \"Fake\"],\n",
        "        discretize_continuous=True\n",
        "    )\n",
        "\n",
        "    exp = explainer.explain_instance(sample[0], predict_fn, num_features=10)\n",
        "    exp.save_to_file(save_path)\n",
        "    print(f\"LIME explanation saved to {os.path.abspath(save_path)}\")\n",
        "\n",
        "# Initialize model, criterion, optimizer\n",
        "hidden_size = 64\n",
        "model = ToxicSynergyModel(input_size, hidden_size).to(device)\n",
        "criterion = CombinedLoss()\n",
        "optimizer = torch.optim.Adam(model.parameters(), lr=0.001)\n",
        "\n",
        "# Train\n",
        "train_model(model, train_loader, optimizer, criterion, epochs=100)\n",
        "\n",
        "# Evaluate\n",
        "evaluate(model, train_loader)\n",
        "\n",
        "# Explain one instance\n",
        "sample_instance = X[:1].numpy()\n",
        "training_data = X[:100].numpy()\n",
        "explain_prediction(model, sample_instance, training_data)\n"
      ]
