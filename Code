        "import pickle\n",
        "import matplotlib.pyplot as plt\n",
        "import os\n",
        "\n",
        "\n",
        "with open(\"model_results.pkl\", \"rb\") as f:\n",
        "    metrics = pickle.load(f)\n",
        "\n",
        "binary_metrics = metrics[\"binary_metrics\"]\n",
        "multilabel_metrics = metrics[\"multilabel_metrics\"]\n",
        "regression_metrics = metrics[\"regression_metrics\"]\n",
        "roc_data = metrics[\"roc_data\"]\n",
        "\n",
        "# -----------------------------\n",
        "# Models\n",
        "# -----------------------------\n",
        "models = [\n",
        "    'CNN',\n",
        "    'LSTM',\n",
        "    'DRNN',\n",
        "    'CNN-RNN',\n",
        "    'BERT',\n",
        "    'IndicBERT',\n",
        "    'MuRIL',\n",
        "    'XLM-R',\n",
        "    'HateBERT',\n",
        "    'Proposed'\n",
        "]\n",
        "\n",
        "\n",
        "colors = [\n",
        "    '#FF5733',\n",
        "    '#33FF57',\n",
        "    '#3357FF',\n",
        "    '#F39C12',\n",
        "    '#9B59B6',\n",
        "    '#1ABC9C',\n",
        "    '#E74C3C',\n",
        "    '#3498DB',\n",
        "    '#2ECC71',\n",
        "    '#8E44AD'\n",
        "]\n",
        "\n",
        "# -----------------------------\n",
        "# Result Folder\n",
        "# -----------------------------\n",
        "os.makedirs(\"result\", exist_ok=True)\n",
        "\n",
        "# -----------------------------\n",
        "# Plot Function\n",
        "# -----------------------------\n",
        "def plot_metric(metric_dict, title, ylabel, filename):\n",
        "\n",
        "    values = [metric_dict[m] for m in models]\n",
        "\n",
        "    plt.figure(figsize=(11,5))\n",
        "\n",
        "    bars = plt.bar(\n",
        "        models,\n",
        "        values,\n",
        "        color=colors,\n",
        "        edgecolor='black',\n",
        "        width=0.6\n",
        "    )\n",
        "\n",
        "    plt.title(title, fontsize=14, fontweight='bold')\n",
        "    plt.ylabel(ylabel)\n",
        "    plt.xticks(rotation=20)\n",
        "    plt.grid(axis='y', linestyle='--', alpha=0.6)\n",
        "\n",
        "    offset = (max(values)-min(values))*0.03 if max(values)<=1 else max(values)*0.02\n",
        "\n",
        "    for bar,value in zip(bars,values):\n",
        "        plt.text(\n",
        "            bar.get_x()+bar.get_width()/2,\n",
        "            value+offset,\n",
        "            f\"{value:.3f}\",\n",
        "            ha='center',\n",
        "            fontsize=9\n",
        "        )\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.savefig(f\"result/{filename}\", dpi=300)\n",
        "    plt.show()\n",
        "    plt.close()\n",
        "\n",
        "\n",
        "# ====================================================\n",
        "# Binary Classification Graphs\n",
        "# ====================================================\n",
        "\n",
        "for key,name in zip(\n",
        "    ['acc','prec','rec','f1','auc'],\n",
        "    ['Accuracy','Precision','Recall','F1 Score','AUC']\n",
        "):\n",
        "\n",
        "    plot_metric(\n",
        "        {m:binary_metrics[m][key] for m in models},\n",
        "        f'Binary Classification - {name}',\n",
        "        name,\n",
        "        f'binary_{key}.png'\n",
        "    )\n",
        "\n",
        "# ====================================================\n",
        "# Multi-label Graphs\n",
        "# ====================================================\n",
        "\n",
        "for key,name in zip(\n",
        "    ['hamming','subset_acc','misclass'],\n",
        "    ['Hamming Loss','Subset Accuracy','Misclassifications']\n",
        "):\n",
        "\n",
        "    plot_metric(\n",
        "        {m:multilabel_metrics[m][key] for m in models},\n",
        "        f'Multi-label Classification - {name}',\n",
        "        name,\n",
        "        f'multilabel_{key}.png'\n",
        "    )\n",
        "\n",
        "# ====================================================\n",
        "# Regression Graphs\n",
        "# ====================================================\n",
        "\n",
        "for key,name in zip(\n",
        "    ['mae','rmse'],\n",
        "    ['MAE','RMSE']\n",
        "):\n",
        "\n",
        "    plot_metric(\n",
        "        {m:regression_metrics[m][key] for m in models},\n",
        "        f'Regression - {name}',\n",
        "        name,\n",
        "        f'regression_{key}.png'\n",
        "    )\n",
        "\n",
        "# ====================================================\n",
        "# Print Metrics\n",
        "# ====================================================\n",
        "\n",
        "for model in models:\n",
        "\n",
        "    b = binary_metrics[model]\n",
        "    m = multilabel_metrics[model]\n",
        "    r = regression_metrics[model]\n",
        "\n",
        "    print(\"\\n\"+\"=\"*65)\n",
        "    print(model)\n",
        "    print(\"=\"*65)\n",
        "\n",
        "    print(\"Binary Classification\")\n",
        "    print(f\"Accuracy      : {b['acc']:.3f}\")\n",
        "    print(f\"Precision     : {b['prec']:.3f}\")\n",
        "    print(f\"Recall        : {b['rec']:.3f}\")\n",
        "    print(f\"F1 Score      : {b['f1']:.3f}\")\n",
        "    print(f\"AUC           : {b['auc']:.3f}\")\n",
        "\n",
        "    print(\"\\nMulti-label Classification\")\n",
        "    print(f\"Hamming Loss  : {m['hamming']:.3f}\")\n",
        "    print(f\"Subset Acc.   : {m['subset_acc']:.3f}\")\n",
        "    print(f\"Misclass.     : {m['misclass']}\")\n",
        "\n",
        "    print(\"\\nRegression\")\n",
        "    print(f\"MAE           : {r['mae']:.3f}\")\n",
        "    print(f\"RMSE          : {r['rmse']:.3f}\")\n",
        "\n",
        "# ====================================================\n",
        "# ROC Curve\n",
        "# ====================================================\n",
        "\n",
        "plt.figure(figsize=(7,6))\n",
        "\n",
        "for model in models:\n",
        "\n",
        "    fpr,tpr = roc_data[model]\n",
        "    auc = binary_metrics[model]['auc']\n",
        "\n",
        "    plt.plot(\n",
        "        fpr,\n",
        "        tpr,\n",
        "        linewidth=2,\n",
        "        label=f\"{model} (AUC={auc:.3f})\"\n",
        "    )\n",
        "\n",
        "plt.plot([0,1],[0,1],'k--',label='Random Guess')\n",
        "\n",
        "plt.xlabel(\"False Positive Rate\")\n",
        "plt.ylabel(\"True Positive Rate\")\n",
        "plt.title(\"ROC Curve Comparison\")\n",
        "plt.grid(True, linestyle='--', alpha=0.5)\n",
        "plt.legend(fontsize=8)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"result/roc_curve.png\", dpi=300)\n",
        "plt.show()\n",
        "\n",
        "print(\"\\nAll graphs have been saved in the 'result' folder.\")"
      ]
    },
