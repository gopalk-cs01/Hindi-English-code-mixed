        "import pandas as pd\n",
        "import re\n",
        "from indic_transliteration.sanscript import transliterate, ITRANS, DEVANAGARI\n",
        "from deep_translator import GoogleTranslator\n",
        "from tqdm import tqdm\n",
        "\n",
        "# ================= CONFIG =================\n",
        "INPUT_FILE = \"tweet_data_updated.csv\"\n",
        "OUTPUT_FILE = \"converted_output_sample.csv\"\n",
        "NUM_SAMPLES = 20          # Change this number if you want\n",
        "# ==========================================\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"🚀 Starting Hinglish → Hindi → English Conversion\")\n",
        "print(f\"📌 Processing only first {NUM_SAMPLES} samples\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "# Load data\n",
        "df = pd.read_csv(INPUT_FILE)\n",
        "print(f\"✅ Loaded {len(df)} total tweets\\n\")\n",
        "\n",
        "df_sample = df.head(NUM_SAMPLES).copy()\n",
        "\n",
        "# Initialize translator\n",
        "translator = GoogleTranslator(source='hi', target='en')\n",
        "\n",
        "def remove_emojis(text):\n",
        "    if not isinstance(text, str):\n",
        "        return \"\"\n",
        "    \n",
        "    emoji_pattern = re.compile(\n",
        "        \"[\"\n",
        "        u\"\\U0001F600-\\U0001F64F\"\n",
        "        u\"\\U0001F300-\\U0001F5FF\"\n",
        "        u\"\\U0001F680-\\U0001F6FF\"\n",
        "        u\"\\U0001F1E0-\\U0001F1FF\"\n",
        "        u\"\\U00002700-\\U000027BF\"\n",
        "        u\"\\U0001F900-\\U0001F9FF\"\n",
        "        u\"\\U00002600-\\U000026FF\"\n",
        "        \"]+\", flags=re.UNICODE\n",
        "    )\n",
        "    \n",
        "    text = emoji_pattern.sub('', text)\n",
        "    text = re.sub(r'[^\\x00-\\x7F]+', '', text)\n",
        "    return text.strip()\n",
        "\n",
        "\n",
        "def transliterate_text(text):\n",
        "    try:\n",
        "        return transliterate(text, ITRANS, DEVANAGARI)\n",
        "    except:\n",
        "        return \"\"\n",
        "\n",
        "\n",
        "def translate_text(text):\n",
        "    if not text or len(text.strip()) < 3:\n",
        "        return \"\"\n",
        "    try:\n",
        "        return translator.translate(text)\n",
        "    except Exception:\n",
        "        return \"[Translation Failed]\"\n",
        "\n",
        "\n",
        "# ================= Processing =================\n",
        "hindi_list = []\n",
        "english_list = []\n",
        "\n",
        "print(\"🔍 Processing samples...\\n\")\n",
        "\n",
        "for index, row in tqdm(df_sample.iterrows(), total=len(df_sample), desc=\"Progress\"):\n",
        "    \n",
        "    original = str(row['Tweet'])\n",
        "    clean_text = remove_emojis(original)\n",
        "    hindi = transliterate_text(clean_text)\n",
        "    english = translate_text(hindi)\n",
        "\n",
        "    hindi_list.append(hindi)\n",
        "    english_list.append(english)\n",
        "\n",
        "    print(\"=\" * 80)\n",
        "    print(f\"Sample {index + 1}\")\n",
        "    print(\"-\" * 80)\n",
        "    print(f\"Hinglish : {original[:140]}{'...' if len(original) > 140 else ''}\")\n",
        "    print(f\"Cleaned  : {clean_text[:140]}{'...' if len(clean_text) > 140 else ''}\")\n",
        "    print(f\"Hindi    : {hindi[:140]}{'...' if len(hindi) > 140 else ''}\")\n",
        "    print(f\"English  : {english}\")\n",
        "    print()\n",
        "\n",
        "# Add columns\n",
        "df_sample['hindi_text'] = hindi_list\n",
        "df_sample['english_translation'] = english_list\n",
        "\n",
        "# Save\n",
        "df_sample.to_csv(OUTPUT_FILE, index=False)\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"🎉 DONE!\")\n",
        "print(f\"✅ Processed : {len(df_sample)} samples\")\n",
        "print(f\"💾 Saved as  : {OUTPUT_FILE}\")\n",
        "print(\"=\" * 70)"
      ]
    },
